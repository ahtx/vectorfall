# VectorFall settings. install.sh writes .env from this file; vfctl, compose.yaml and compose.podman.yaml read it.
# .env is never committed. Real environment variables always win.

# ---- the server (install.sh and vfctl set these) ----
# docker or podman (empty: the one that works)
VF_ENGINE=
# The image. Build your own with: vfctl update --build <source folder>
VF_IMAGE=ghcr.io/ahtx/vectorfall:0.1.0
# The container name.
VF_NAME=vectorfall
# The NVIDIA card that VectorFall uses: a UUID (or an index) from `nvidia-smi -L`. VectorFall owns this card.
VF_GPU=0
# The address the ports listen on: 127.0.0.1 = this computer only, 0.0.0.0 = the local network too.
VF_BIND=127.0.0.1
# The web interface and API (http) and the HTTPS port (the browser allows the microphone and camera only on HTTPS).
VF_PORT=8092
VF_TLS_PORT=8493
# The data folder (uploads, projects, caches, the certificate), relative to this folder or absolute.
VF_DATA=./data

# Names and IP addresses the self-signed HTTPS certificate is valid for, comma-separated.
# Add the LAN address and host name your browser uses to reach the server.
VF_TLS_HOSTS=localhost,127.0.0.1

# Extra networks (CIDR, comma-separated) allowed to use the Console besides private LAN ranges and loopback,
# for example a VPN range. Leave empty for none.
VF_TRUSTED_NETS=

# ---- clients ----
# Where the vf command-line client and the stdio MCP proxy (mcp/vectorfall_mcp.py) find the server.
VF_URL=http://localhost:8092
VECTORFALL_URL=http://localhost:8092

# Particle Lab S&P 500 download: the SEC asks automated clients to name a contact (a name and an e-mail address)
# VF_SEC_CONTACT=
